{
  "manifest_version": 3,
  "name": "StudySnap",
  "version": "2.2.0",
  "default_locale": "en",
  "description": "__MSG_appDesc__",

  "action": {
    "default_popup": "popup.html",
    "default_title": "StudySnap — AI Study Assistant",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "identity"
  ],

  "host_permissions": [
    "https://trystudysnap.com/*",
    "https://vmoqyntmuyrehrtzubmj.supabase.co/*"
  ],

  "commands": {
    "capture-question": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac":     "Command+Shift+K"
      },
      "description": "Capture and answer questions on the current page"
    }
  }
}
